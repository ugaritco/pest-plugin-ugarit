{
    "name": "ugaritco/pest-plugin-ugarit",
    "description": "The Pest Ugarit Plugin",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "ugarit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4",
        "ugarit/framework": "^1.00.00",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Pest\\Ugarit\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "ugarit": {
            "providers": [
                "Pest\\Ugarit\\PestServiceProvider"
            ]
        },
        "heritage": {
            "providers": [
                "Pest\\Ugarit\\PestServiceProvider"
            ]
        },
        "pest": {
            "plugins": [
                "Pest\\Ugarit\\Plugin"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:unit": "pest --colors=always --exclude-group=options",
        "test:unit:options": "pest --group=options --without-exception-handling --without-deprecation-handling",
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:unit:options"
        ]
    }
}
